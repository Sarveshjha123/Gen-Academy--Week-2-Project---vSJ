# 1) Make a COPY of this file and name the copy exactly:  .env
# 2) Fill in the values below. Never share or upload the .env file.

# --- Nebius (the "brain") ---
NEBIUS_API_KEY=paste-your-nebius-key-here
# Copy the base URL shown in your Nebius dashboard (in the API / quickstart code sample)
NEBIUS_BASE_URL=https://api.studio.nebius.com/v1/
# Copy a large chat model name exactly as shown in the Nebius model list
CHAT_MODEL=openai/gpt-oss-120b
# Optional: low / medium / high. "low" makes gpt-oss answer faster
# REASONING_EFFORT=low

# --- Pinecone (the "memory") ---
PINECONE_API_KEY=paste-your-pinecone-key-here
PINECONE_INDEX=cloudpaw-renewals

# --- Fixed "today" so dates match the data ---
TODAY=2026-10-17
